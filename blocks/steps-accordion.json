{
  "$schema": "../schema/block.schema.json",
  "format": 1,
  "id": "steps-accordion",
  "kind": "accordion",
  "label": "Steps",
  "hint": "How it works, step by step: each numbered step opens to what happens in it, one at a time",
  "category": "content",
  "isNew": true,
  "settings": {
    "single": true,
    "start": 0
  },
  "root": {
    "type": "stack",
    "name": "Steps",
    "w": 640,
    "h": 520,
    "layout": {
      "direction": "column",
      "gap": 12,
      "pad": [
        0,
        0,
        0,
        0
      ],
      "align": "stretch"
    },
    "sizeW": "fixed",
    "sizeH": "fit",
    "children": [
      {
        "type": "stack",
        "name": "Item {n}",
        "part": "item",
        "w": 640,
        "h": 124,
        "repeat": 3,
        "layout": {
          "direction": "column",
          "gap": 0,
          "pad": [
            0,
            0,
            0,
            0
          ]
        },
        "sizeW": "fill",
        "sizeH": "fit",
        "clip": true,
        "children": [
          {
            "type": "stack",
            "name": "Header",
            "part": "header",
            "w": 640,
            "h": 60,
            "layout": {
              "direction": "row",
              "gap": 12,
              "pad": [
                16,
                20,
                16,
                20
              ],
              "align": "center",
              "justify": "start"
            },
            "sizeW": "fill",
            "sizeH": "fit",
            "children": [
              {
                "type": "text",
                "name": "Number",
                "w": 32,
                "h": 24,
                "text": "{n}.",
                "ink": "accent",
                "typography": {
                  "role": "heading",
                  "size": 17,
                  "weight": 600
                }
              },
              {
                "type": "text",
                "name": "Question",
                "w": 540,
                "h": 24,
                "sizeW": "fill",
                "text": "Step {n}",
                "ink": "ink",
                "typography": {
                  "role": "heading",
                  "size": 17,
                  "weight": 600
                }
              },
              {
                "type": "text",
                "name": "Icon",
                "part": "icon",
                "w": 24,
                "h": 28,
                "text": "+",
                "ink": "ink",
                "typography": {
                  "role": "body",
                  "size": 28,
                  "weight": 300,
                  "align": "center"
                }
              }
            ]
          },
          {
            "type": "stack",
            "name": "Panel",
            "part": "panel",
            "w": 640,
            "h": 64,
            "layout": {
              "direction": "column",
              "gap": 0,
              "pad": [
                0,
                20,
                20,
                64
              ]
            },
            "sizeW": "fill",
            "sizeH": "fit",
            "children": [
              {
                "type": "text",
                "name": "Answer",
                "w": 600,
                "h": 44,
                "sizeW": "fill",
                "text": "What happens in step {n}, in a sentence or two.",
                "ink": "ink",
                "typography": {
                  "role": "body",
                  "size": 15,
                  "weight": 400
                }
              }
            ]
          }
        ],
        "fill": "surface",
        "radius": "design"
      }
    ]
  }
}
