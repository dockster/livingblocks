{
  "$schema": "../schema/block.schema.json",
  "format": 1,
  "id": "testimonial-carousel",
  "kind": "carousel",
  "label": "Testimonials",
  "hint": "What people say about you, a quote at a time, with their face and name",
  "category": "content",
  "isNew": true,
  "settings": {
    "perView": 1,
    "loop": true,
    "autoplay": false,
    "interval": 5,
    "arrows": true,
    "dots": true,
    "swipe": true,
    "start": 0,
    "parallax": 0
  },
  "root": {
    "type": "stack",
    "name": "Testimonials",
    "w": 720,
    "h": 264,
    "layout": {
      "direction": "column",
      "gap": 16,
      "pad": [
        0,
        0,
        0,
        0
      ],
      "align": "center"
    },
    "sizeW": "fixed",
    "sizeH": "fit",
    "children": [
      {
        "type": "stack",
        "name": "View",
        "w": 720,
        "h": 240,
        "layout": {
          "direction": "row",
          "gap": 0,
          "pad": [
            0,
            0,
            0,
            0
          ],
          "align": "stretch"
        },
        "sizeW": "fill",
        "sizeH": "fixed",
        "clip": true,
        "radius": "design",
        "children": [
          {
            "type": "stack",
            "name": "Slides",
            "part": "track",
            "w": 2160,
            "h": 240,
            "layout": {
              "direction": "row",
              "gap": 0,
              "pad": [
                0,
                0,
                0,
                0
              ],
              "align": "stretch"
            },
            "sizeW": "fit",
            "sizeH": "fill",
            "children": [
              {
                "type": "stack",
                "name": "Slide {n}",
                "w": 720,
                "h": 240,
                "layout": {
                  "direction": "column",
                  "gap": 0,
                  "pad": [
                    32,
                    88,
                    32,
                    88
                  ],
                  "align": "center",
                  "justify": "center"
                },
                "sizeW": "fixed",
                "sizeH": "fill",
                "clip": true,
                "children": [
                  {
                    "type": "stack",
                    "name": "Card",
                    "w": 544,
                    "h": 120,
                    "layout": {
                      "direction": "column",
                      "gap": 16,
                      "pad": [
                        0,
                        0,
                        0,
                        0
                      ],
                      "align": "center"
                    },
                    "sizeW": "fill",
                    "sizeH": "fit",
                    "children": [
                      {
                        "type": "text",
                        "name": "Quote",
                        "w": 544,
                        "h": 56,
                        "text": "The calmest hour of my week. I leave lighter every time.",
                        "ink": "ink",
                        "typography": {
                          "role": "body",
                          "size": 17,
                          "weight": 400,
                          "align": "center"
                        },
                        "sizeW": "fill"
                      },
                      {
                        "type": "stack",
                        "name": "Person",
                        "w": 240,
                        "h": 48,
                        "layout": {
                          "direction": "row",
                          "gap": 12,
                          "pad": [
                            0,
                            0,
                            0,
                            0
                          ],
                          "align": "center"
                        },
                        "sizeW": "fit",
                        "sizeH": "fit",
                        "children": [
                          {
                            "type": "image",
                            "name": "Photo",
                            "part": "picture",
                            "w": 48,
                            "h": 48,
                            "radius": 24
                          },
                          {
                            "type": "stack",
                            "name": "Who",
                            "w": 180,
                            "h": 44,
                            "layout": {
                              "direction": "column",
                              "gap": 0,
                              "pad": [
                                0,
                                0,
                                0,
                                0
                              ]
                            },
                            "sizeW": "fit",
                            "sizeH": "fit",
                            "children": [
                              {
                                "type": "text",
                                "name": "Name",
                                "w": 180,
                                "h": 22,
                                "text": "Person {n}",
                                "ink": "ink",
                                "typography": {
                                  "role": "body",
                                  "size": 15,
                                  "weight": 600
                                }
                              },
                              {
                                "type": "text",
                                "name": "Role",
                                "w": 180,
                                "h": 22,
                                "text": "Member since 2024",
                                "ink": "ink",
                                "typography": {
                                  "role": "body",
                                  "size": 15,
                                  "weight": 400
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ],
                "repeat": 3,
                "fill": "surface"
              }
            ]
          },
          {
            "type": "button",
            "name": "Previous",
            "part": "prev",
            "w": 44,
            "h": 44,
            "fill": "accent",
            "ink": "on-accent",
            "radius": 22,
            "text": "←",
            "typography": {
              "role": "body",
              "size": 17,
              "weight": 600,
              "align": "center"
            },
            "float": {
              "left": 16,
              "centreY": true
            }
          },
          {
            "type": "button",
            "name": "Next",
            "part": "next",
            "w": 44,
            "h": 44,
            "fill": "accent",
            "ink": "on-accent",
            "radius": 22,
            "text": "→",
            "typography": {
              "role": "body",
              "size": 17,
              "weight": 600,
              "align": "center"
            },
            "float": {
              "right": 16,
              "centreY": true
            }
          },
          {
            "type": "button",
            "name": "Pause",
            "part": "pause",
            "w": 88,
            "h": 44,
            "fill": "accent",
            "ink": "on-accent",
            "radius": 22,
            "text": "Pause",
            "typography": {
              "role": "body",
              "size": 15,
              "weight": 600,
              "align": "center"
            },
            "float": {
              "right": 16,
              "top": 16
            },
            "hidden": true
          }
        ]
      },
      {
        "type": "stack",
        "name": "Dots",
        "part": "dots",
        "w": 40,
        "h": 8,
        "layout": {
          "direction": "row",
          "gap": 8,
          "pad": [
            0,
            0,
            0,
            0
          ],
          "align": "center"
        },
        "sizeW": "fit",
        "sizeH": "fit",
        "children": [
          {
            "type": "ellipse",
            "name": "Dot {n}",
            "w": 8,
            "h": 8,
            "fill": "accent",
            "repeat": 3
          }
        ]
      }
    ]
  }
}
