{
  "$schema": "../schema/block.schema.json",
  "format": 1,
  "id": "logo-strip",
  "kind": "carousel",
  "label": "Logo strip",
  "hint": "The logos of the people you work with, passing on their own, four at once, with a Pause",
  "category": "content",
  "isNew": true,
  "settings": {
    "perView": 4,
    "loop": true,
    "autoplay": true,
    "interval": 3,
    "arrows": false,
    "dots": false,
    "swipe": true,
    "start": 0,
    "parallax": 0
  },
  "root": {
    "type": "stack",
    "name": "Logo strip",
    "w": 640,
    "h": 156,
    "layout": {
      "direction": "column",
      "gap": 16,
      "pad": [
        0,
        0,
        0,
        0
      ],
      "align": "center"
    },
    "sizeW": "fixed",
    "sizeH": "fit",
    "children": [
      {
        "type": "stack",
        "name": "View",
        "w": 640,
        "h": 96,
        "layout": {
          "direction": "row",
          "gap": 0,
          "pad": [
            0,
            0,
            0,
            0
          ],
          "align": "stretch"
        },
        "sizeW": "fill",
        "sizeH": "fixed",
        "clip": true,
        "radius": "design",
        "children": [
          {
            "type": "stack",
            "name": "Slides",
            "part": "track",
            "w": 1280,
            "h": 96,
            "layout": {
              "direction": "row",
              "gap": 0,
              "pad": [
                0,
                0,
                0,
                0
              ],
              "align": "stretch"
            },
            "sizeW": "fit",
            "sizeH": "fill",
            "children": [
              {
                "type": "stack",
                "name": "Logo {n}",
                "w": 160,
                "h": 96,
                "layout": {
                  "direction": "column",
                  "gap": 0,
                  "pad": [
                    24,
                    24,
                    24,
                    24
                  ],
                  "align": "stretch",
                  "justify": "center"
                },
                "sizeW": "fixed",
                "sizeH": "fill",
                "children": [
                  {
                    "type": "image",
                    "name": "Logo",
                    "part": "picture",
                    "w": 112,
                    "h": 48,
                    "sizeW": "fill",
                    "sizeH": "fill",
                    "contain": true
                  }
                ],
                "repeat": 8
              }
            ]
          },
          {
            "type": "button",
            "name": "Previous",
            "part": "prev",
            "w": 44,
            "h": 44,
            "fill": "accent",
            "ink": "on-accent",
            "radius": 22,
            "text": "←",
            "typography": {
              "role": "body",
              "size": 17,
              "weight": 600,
              "align": "center"
            },
            "float": {
              "left": 16,
              "centreY": true
            }
          },
          {
            "type": "button",
            "name": "Next",
            "part": "next",
            "w": 44,
            "h": 44,
            "fill": "accent",
            "ink": "on-accent",
            "radius": 22,
            "text": "→",
            "typography": {
              "role": "body",
              "size": 17,
              "weight": 600,
              "align": "center"
            },
            "float": {
              "right": 16,
              "centreY": true
            }
          }
        ]
      },
      {
        "type": "stack",
        "name": "Below",
        "w": 200,
        "h": 44,
        "layout": {
          "direction": "row",
          "gap": 16,
          "pad": [
            0,
            0,
            0,
            0
          ],
          "align": "center",
          "justify": "center"
        },
        "sizeW": "fit",
        "sizeH": "fit",
        "children": [
          {
            "type": "stack",
            "name": "Dots",
            "part": "dots",
            "w": 72,
            "h": 8,
            "layout": {
              "direction": "row",
              "gap": 8,
              "pad": [
                0,
                0,
                0,
                0
              ],
              "align": "center"
            },
            "sizeW": "fit",
            "sizeH": "fit",
            "children": [
              {
                "type": "ellipse",
                "name": "Dot {n}",
                "w": 8,
                "h": 8,
                "fill": "accent",
                "repeat": 5
              }
            ]
          },
          {
            "type": "button",
            "name": "Pause",
            "part": "pause",
            "w": 88,
            "h": 44,
            "fill": "accent",
            "ink": "on-accent",
            "radius": 22,
            "text": "Pause",
            "typography": {
              "role": "body",
              "size": 15,
              "weight": 600,
              "align": "center"
            }
          }
        ]
      }
    ]
  }
}
