{
  "$schema": "../schema/block.schema.json",
  "format": 1,
  "id": "product-carousel",
  "kind": "carousel",
  "label": "Products",
  "hint": "Products side by side, three at once, each with a picture, a price and a button",
  "category": "content",
  "isNew": true,
  "settings": {
    "perView": 3,
    "loop": false,
    "autoplay": false,
    "interval": 5,
    "arrows": true,
    "dots": true,
    "swipe": true,
    "start": 0,
    "parallax": 0
  },
  "root": {
    "type": "stack",
    "name": "Products",
    "w": 944,
    "h": 424,
    "layout": {
      "direction": "column",
      "gap": 16,
      "pad": [
        0,
        0,
        0,
        0
      ],
      "align": "center"
    },
    "sizeW": "fixed",
    "sizeH": "fit",
    "children": [
      {
        "type": "stack",
        "name": "View",
        "w": 944,
        "h": 400,
        "layout": {
          "direction": "row",
          "gap": 0,
          "pad": [
            0,
            0,
            0,
            0
          ],
          "align": "stretch"
        },
        "sizeW": "fill",
        "sizeH": "fixed",
        "clip": true,
        "radius": "design",
        "children": [
          {
            "type": "stack",
            "name": "Slides",
            "part": "track",
            "w": 1920,
            "h": 400,
            "layout": {
              "direction": "row",
              "gap": 16,
              "pad": [
                0,
                0,
                0,
                0
              ],
              "align": "stretch"
            },
            "sizeW": "fit",
            "sizeH": "fill",
            "children": [
              {
                "type": "stack",
                "name": "Product {n}",
                "w": 304,
                "h": 400,
                "layout": {
                  "direction": "column",
                  "gap": 12,
                  "pad": [
                    0,
                    0,
                    20,
                    0
                  ],
                  "align": "stretch"
                },
                "sizeW": "fixed",
                "sizeH": "fill",
                "clip": true,
                "fill": "surface",
                "radius": "design",
                "children": [
                  {
                    "type": "image",
                    "name": "Picture",
                    "part": "picture",
                    "w": 304,
                    "h": 228,
                    "sizeW": "fill",
                    "sizeH": "fixed"
                  },
                  {
                    "type": "stack",
                    "name": "Info",
                    "w": 304,
                    "h": 48,
                    "layout": {
                      "direction": "column",
                      "gap": 4,
                      "pad": [
                        0,
                        16,
                        0,
                        16
                      ]
                    },
                    "sizeW": "fill",
                    "sizeH": "fit",
                    "children": [
                      {
                        "type": "text",
                        "name": "Name",
                        "w": 272,
                        "h": 24,
                        "text": "Product {n}",
                        "ink": "ink",
                        "typography": {
                          "role": "heading",
                          "size": 17,
                          "weight": 600
                        },
                        "sizeW": "fill"
                      },
                      {
                        "type": "text",
                        "name": "Price",
                        "w": 272,
                        "h": 20,
                        "text": "€49",
                        "ink": "ink",
                        "typography": {
                          "role": "body",
                          "size": 15,
                          "weight": 400
                        },
                        "sizeW": "fill"
                      }
                    ]
                  },
                  {
                    "type": "stack",
                    "name": "Action",
                    "w": 304,
                    "h": 44,
                    "layout": {
                      "direction": "row",
                      "gap": 0,
                      "pad": [
                        0,
                        16,
                        0,
                        16
                      ]
                    },
                    "sizeW": "fill",
                    "sizeH": "fit",
                    "children": [
                      {
                        "type": "button",
                        "name": "Add to bag",
                        "w": 272,
                        "h": 44,
                        "fill": "accent",
                        "ink": "on-accent",
                        "radius": "design",
                        "text": "Add to bag",
                        "typography": {
                          "role": "body",
                          "size": 15,
                          "weight": 600,
                          "align": "center"
                        },
                        "sizeW": "fill"
                      }
                    ]
                  }
                ],
                "repeat": 6
              }
            ]
          },
          {
            "type": "button",
            "name": "Previous",
            "part": "prev",
            "w": 44,
            "h": 44,
            "fill": "accent",
            "ink": "on-accent",
            "radius": 22,
            "text": "←",
            "typography": {
              "role": "body",
              "size": 17,
              "weight": 600,
              "align": "center"
            },
            "float": {
              "left": 16,
              "centreY": true
            }
          },
          {
            "type": "button",
            "name": "Next",
            "part": "next",
            "w": 44,
            "h": 44,
            "fill": "accent",
            "ink": "on-accent",
            "radius": 22,
            "text": "→",
            "typography": {
              "role": "body",
              "size": 17,
              "weight": 600,
              "align": "center"
            },
            "float": {
              "right": 16,
              "centreY": true
            }
          },
          {
            "type": "button",
            "name": "Pause",
            "part": "pause",
            "w": 88,
            "h": 44,
            "fill": "accent",
            "ink": "on-accent",
            "radius": 22,
            "text": "Pause",
            "typography": {
              "role": "body",
              "size": 15,
              "weight": 600,
              "align": "center"
            },
            "float": {
              "right": 16,
              "top": 16
            },
            "hidden": true
          }
        ]
      },
      {
        "type": "stack",
        "name": "Dots",
        "part": "dots",
        "w": 56,
        "h": 8,
        "layout": {
          "direction": "row",
          "gap": 8,
          "pad": [
            0,
            0,
            0,
            0
          ],
          "align": "center"
        },
        "sizeW": "fit",
        "sizeH": "fit",
        "children": [
          {
            "type": "ellipse",
            "name": "Dot {n}",
            "w": 8,
            "h": 8,
            "fill": "accent",
            "repeat": 4
          }
        ]
      }
    ]
  }
}
